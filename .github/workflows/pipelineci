jobs:
  start-httpbin:
    runs-on: ubuntu-latest
    services:
      httpbin:
        image: kennethreitz/httpbin
        ports:
          - 91:80
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Wait for httpbin to start
        run: |
          echo "Waiting for httpbin service..."
          for i in {1..10}; do
            curl -s http://localhost:91/get && break
            echo "HTTPBin not ready yet... retrying ($i/10)"
            sleep 3
          done
